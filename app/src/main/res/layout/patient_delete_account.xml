<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_delete_account" />
        <TextView style="@style/PatientBody" android:id="@+id/delete_notice" android:text="@string/delete_notice" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/confirm_delete" android:text="@string/confirm_delete" />
        <TextView style="@style/PatientBody" android:id="@+id/result"  />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
