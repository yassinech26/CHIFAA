<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/chat_bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/chat_role" style="@style/KbNotice"
        android:layout_width="match_parent" android:layout_height="wrap_content"  />
        <TextView android:id="@+id/chat_resource_heading" style="@style/KbSubtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_distress" />
        <TextView android:id="@+id/chat_body" style="@style/KbBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"  />
        <Button android:id="@+id/chat_reference" style="@style/KbButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title" />
        <Button android:id="@+id/chat_rate" style="@style/KbButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_rate" />
    </LinearLayout>
</FrameLayout>
