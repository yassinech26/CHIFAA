<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b3_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kb_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/kb_margin"
        android:paddingEnd="@dimen/kb_margin"
        android:paddingTop="@dimen/kb_gap"
        android:paddingBottom="@dimen/kb_gap">
        <TextView
            android:id="@+id/b2_heading"
            style="@style/KbTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b2_list" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/b2_back"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/b2_back" />
            <Button
                android:id="@+id/b3_reload"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kb_retry" />
        </LinearLayout>
        <include
            layout="@layout/b3_feedback" />
        <LinearLayout
            android:id="@+id/b2_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/KbBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/b2_filter"
                android:labelFor="@+id/b2_filter" />
            <Spinner
                android:id="@+id/b2_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/kb_target"
                android:saveEnabled="false" />
        </LinearLayout>
        <Button
            android:id="@+id/b2_create"
            style="@style/KbButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/b2_create" />
        <ListView
            android:id="@+id/b2_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:saveEnabled="false" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/b2_prev"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_previous" />
            <Button
                android:id="@+id/b2_next"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
