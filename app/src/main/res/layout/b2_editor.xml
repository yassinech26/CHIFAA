<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b3_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kb_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/kb_margin"
        android:paddingEnd="@dimen/kb_margin"
        android:paddingTop="@dimen/kb_gap"
        android:paddingBottom="@dimen/kb_gap">
        <TextView
            android:id="@+id/b2_heading"
            style="@style/KbTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b2_editor" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/b2_back"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/b2_back" />
            <Button
                android:id="@+id/b3_reload"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kb_retry" />
        </LinearLayout>
        <include
            layout="@layout/b3_feedback" />
        <Button
            android:id="@+id/b2_recover"
            style="@style/KbButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/b2_history" />
        <ScrollView
            android:id="@+id/b2_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:saveEnabled="false">
            <LinearLayout
                android:id="@+id/b2_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/b2_meta"
                    style="@style/KbSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/b2_notice"
                    style="@style/KbNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kb_notice" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_title"
                    android:labelFor="@+id/b2_title" />
                <EditText
                    android:id="@+id/b2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:maxLength="200" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_topic"
                    android:labelFor="@+id/b2_topic" />
                <EditText
                    android:id="@+id/b2_topic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:maxLength="50" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_language"
                    android:labelFor="@+id/b2_language" />
                <Spinner
                    android:id="@+id/b2_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:saveEnabled="false" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_content"
                    android:labelFor="@+id/b2_body" />
                <EditText
                    android:id="@+id/b2_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_source"
                    android:labelFor="@+id/b2_source" />
                <EditText
                    android:id="@+id/b2_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:maxLength="25" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_reference"
                    android:labelFor="@+id/b2_reference" />
                <EditText
                    android:id="@+id/b2_reference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_evidence"
                    android:labelFor="@+id/b2_evidence" />
                <Spinner
                    android:id="@+id/b2_evidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:saveEnabled="false" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_local"
                    android:labelFor="@+id/b2_local" />
                <Spinner
                    android:id="@+id/b2_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:saveEnabled="false" />
                <TextView
                    style="@style/KbBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_expiry"
                    android:labelFor="@+id/b2_expiry" />
                <EditText
                    android:id="@+id/b2_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/kb_target"
                    android:inputType="textNoSuggestions"
                    android:saveEnabled="false"
                    android:importantForAutofill="no"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:maxLength="10" />
                <Button
                    android:id="@+id/b2_save"
                    style="@style/KbButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/b2_save" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
