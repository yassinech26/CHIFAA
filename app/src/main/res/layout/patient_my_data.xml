<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_my_data" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/manage_consents" android:text="@string/manage_consents" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/export" android:text="@string/export" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/delete_account" android:text="@string/delete_account" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
