<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/e3_gap"
    app:cardBackgroundColor="@color/background" app:cardCornerRadius="@dimen/e3_card_radius"
    app:cardElevation="0dp" app:strokeColor="@color/warning" app:strokeWidth="1dp">
    <LinearLayout android:id="@+id/supportLinks" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/e3_gap">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/e3_support" android:textColor="@color/text_primary"
            android:textSize="@dimen/e3_subtitle" app:drawableStartCompat="@drawable/e3_support"
            android:drawablePadding="@dimen/e3_gap" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
