<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/kb_root" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/kb_margin">
        <com.google.android.material.button.MaterialButton android:id="@+id/kb_back" style="@style/KbButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kb_back" />
        <TextView android:id="@+id/kb_status" style="@style/KbBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
        <LinearLayout android:id="@+id/kb_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/kb_title" style="@style/KbTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/kb_notice" style="@style/KbNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kb_notice" />
            <TextView android:id="@+id/kb_body" style="@style/KbBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/kb_gap" android:textIsSelectable="true"/>
            <TextView android:id="@+id/kb_metadata" style="@style/KbBody" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/kb_retry" style="@style/KbButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kb_retry" />
    </LinearLayout>
</ScrollView>
