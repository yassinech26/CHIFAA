<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_welcome" />
        <TextView style="@style/PatientBody" android:id="@+id/welcome_limits" android:text="@string/welcome_limits" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/sign_up" android:text="@string/sign_up" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/sign_in" android:text="@string/sign_in" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
