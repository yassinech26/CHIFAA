<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_profile" />
        <TextView style="@style/PatientBody" android:id="@+id/result"  />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/edit_profile" android:text="@string/edit_profile" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/language_settings" android:text="@string/language_settings" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/health_home" android:text="@string/health_home" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/my_data" android:text="@string/my_data" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/sign_out" android:text="@string/sign_out" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
