<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_age" />
        <TextView style="@style/PatientBody" android:id="@+id/age_question" android:text="@string/age_question" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/adult_yes" android:text="@string/adult_yes" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/adult_no" android:text="@string/adult_no" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
