<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/kb_margin">

        <Button
            android:id="@+id/open_library"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kb_library" />

        <Button
            android:id="@+id/open_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kb_gap"
            android:text="@string/chat_title" />

        <Button
            android:id="@+id/open_safety"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kb_gap"
            android:visibility="gone"
            android:text="@string/b3_queue" />

        <Button
            android:id="@+id/open_review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kb_gap"
            android:visibility="gone"
            android:text="@string/b2_list" />
    </LinearLayout>
</ScrollView>
