<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_export" />
        <TextView style="@style/PatientBody" android:id="@+id/export_notice" android:text="@string/export_notice" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/json" android:text="@string/json" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/csv" android:text="@string/csv" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
