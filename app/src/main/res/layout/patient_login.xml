<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_login" />
        <TextView style="@style/PatientLabel" android:labelFor="@id/phone" android:text="@string/phone" />
        <EditText style="@style/PatientField" android:id="@+id/phone" android:textDirection="ltr" android:digits="@string/patient_phone_digits" android:singleLine="true" android:saveEnabled="false" android:inputType="phone" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/send_code" android:text="@string/send_code" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
