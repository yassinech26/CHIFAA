<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/b3_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kb_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/kb_margin"
        android:paddingEnd="@dimen/kb_margin"
        android:paddingTop="@dimen/kb_gap"
        android:paddingBottom="@dimen/kb_gap">
        <TextView
            style="@style/KbTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b3_queue" />
        <TextView
            style="@style/KbBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b3_filter"
            android:labelFor="@+id/b3_filter" />
        <Spinner
            android:id="@+id/b3_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/kb_target"
            android:saveEnabled="false" />
        <Button
            android:id="@+id/b3_reload"
            style="@style/KbButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kb_retry" />
        <include
            layout="@layout/b3_feedback" />
        <ListView
            android:id="@+id/b3_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:saveEnabled="false" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/b3_prev"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_previous"
                android:visibility="gone" />
            <Button
                android:id="@+id/b3_next"
                style="@style/KbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_next"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
