<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/patient_background">
    <LinearLayout style="@style/PatientPage">
        <TextView style="@style/PatientTitle" android:text="@string/title_language_settings" />
        <com.google.android.material.button.MaterialButton style="@style/PatientButton" android:id="@+id/french" android:text="@string/french" />
        <com.google.android.material.button.MaterialButton style="@style/PatientSecondary" android:id="@+id/arabic" android:text="@string/arabic" />
        <include layout="@layout/patient_feedback" />
    </LinearLayout>
</ScrollView>
