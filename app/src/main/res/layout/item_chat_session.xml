<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/sessionDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/e3_subtitle" android:accessibilityHeading="true" />
    <TextView android:id="@+id/sessionPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="@dimen/e3_body" />
    <com.google.android.material.button.MaterialButton android:id="@+id/openSession" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/e3_touch" android:textAllCaps="false"
        android:text="@string/e3_detail" app:cornerRadius="@dimen/e3_button_radius" />
</LinearLayout>
