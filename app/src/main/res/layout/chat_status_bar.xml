<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <ProgressBar android:id="@+id/chat_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:visibility="gone"
        android:contentDescription="@string/chat_loading" />
    <TextView android:id="@+id/chat_status" style="@style/KbNotice"
        android:layout_width="match_parent" android:layout_height="wrap_content"  android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <Button android:id="@+id/chat_retry" style="@style/KbButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_retry" android:visibility="gone" />
</LinearLayout>
