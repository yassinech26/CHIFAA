<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/chat_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/kb_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="@dimen/kb_margin" android:paddingEnd="@dimen/kb_margin"
        android:paddingTop="@dimen/kb_gap" android:paddingBottom="@dimen/kb_gap">
        <TextView android:id="@+id/chat_heading" style="@style/KbTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title" />
        <include layout="@layout/chat_status_bar" />
        <ListView android:id="@+id/chat_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:saveEnabled="false" android:divider="@null" android:dividerHeight="@dimen/kb_gap" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/chat_previous" style="@style/KbButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_previous" android:visibility="gone" />
        <Button android:id="@+id/chat_next" style="@style/KbButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_next" android:visibility="gone" />
    </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="@string/chat_hint" android:minHeight="@dimen/kb_target" android:maxLines="4"
                android:maxLength="4000" android:inputType="textMultiLine|textNoSuggestions" android:saveEnabled="false"
                android:imeOptions="flagNoPersonalizedLearning" android:importantForAutofill="no" />
            <Button android:id="@+id/chat_send" style="@style/KbButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
